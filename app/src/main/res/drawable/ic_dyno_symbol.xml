<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Speed Lines on the left of D (Speed streaks) -->
    <path
        android:pathData="M 24,51 L 37,51 L 35,55 L 22,55 Z"
        android:fillColor="#00E5FF" />
    <path
        android:pathData="M 27,58 L 40,58 L 38,62 L 25,62 Z"
        android:fillColor="#00B0FF" />
    <path
        android:pathData="M 31,65 L 44,65 L 42,69 L 29,69 Z"
        android:fillColor="#1565C0" />

    <!-- Outer Stylized 'D' Silhouette -->
    <path
        android:pathData="M 36,32 L 60,32 C 77,32 86,42 86,54 C 86,66 77,76 60,76 L 36,76 C 34,76 33,74 34,72 L 37,66 L 47,66 C 56,66 68,61 68,54 C 68,46 56,42 47,42 L 37,42 L 34,36 C 33,34 34,32 36,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="32"
                android:endX="86"
                android:endY="76"
                android:type="linear">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#0091EA" android:offset="0.5" />
                <item android:color="#1565C0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Dark Gauge Dial Face (Deep Navy) -->
    <path
        android:pathData="M 54,54 m -18,0 a 18,18 0 1,0 36,0 a 18,18 0 1,0 -36,0"
        android:fillColor="#050E22" />

    <!-- Normal Range Gauge Arc (Cyan to Electric Blue) -->
    <path
        android:pathData="M 39,64 A 17,17 0 0,1 54,37"
        android:strokeWidth="3.2"
        android:strokeColor="#00E5FF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Mid-Range Power Arc (Orange) -->
    <path
        android:pathData="M 54,37 A 17,17 0 0,1 66,42"
        android:strokeWidth="3.2"
        android:strokeColor="#FF8800"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- High-RPM / Redline Zone (Racing Red) -->
    <path
        android:pathData="M 66,42 A 17,17 0 0,1 70,51"
        android:strokeWidth="3.2"
        android:strokeColor="#FF1E42"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Center Pivot Ring -->
    <path
        android:pathData="M 54,54 m -5,0 a 5,5 0 1,0 10,0 a 5,5 0 1,0 -10,0"
        android:fillColor="#0B1630"
        android:strokeColor="#FF5500"
        android:strokeWidth="1.2" />

    <!-- Dynamic Orange Needle pointing Up-Right into Redline (~45 deg) -->
    <path
        android:pathData="M 54,54 L 68,40"
        android:strokeWidth="2.8"
        android:strokeColor="#FF8A3D"
        android:strokeLineCap="round" />

    <!-- Inner Pivot Hub Dot -->
    <path
        android:pathData="M 54,54 m -2.2,0 a 2.2,2.2 0 1,0 4.4,0 a 2.2,2.2 0 1,0 -4.4,0"
        android:fillColor="#FF5500" />

</vector>
